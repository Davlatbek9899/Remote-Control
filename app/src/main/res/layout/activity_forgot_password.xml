<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F7FA"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Step 1: Email -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="🔐"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_blue"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parolni tiklash"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emailingizni kiriting, kod yuboramiz"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <EditText
                    android:id="@+id/etForgotEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Email"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:background="@drawable/input_light"
                    android:paddingHorizontal="16dp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Kod yuborish"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_blue"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Step 2: Kod kiritish -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="✉️"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_blue"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kodni kiriting"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSentTo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kod emailga yuborildi"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText android:id="@+id/etCode1"
                        android:layout_width="52dp" android:layout_height="60dp"
                        android:background="@drawable/input_light"
                        android:gravity="center" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1A1A2E" android:inputType="number"
                        android:maxLength="1" android:layout_marginHorizontal="5dp"/>
                    <EditText android:id="@+id/etCode2"
                        android:layout_width="52dp" android:layout_height="60dp"
                        android:background="@drawable/input_light"
                        android:gravity="center" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1A1A2E" android:inputType="number"
                        android:maxLength="1" android:layout_marginHorizontal="5dp"/>
                    <EditText android:id="@+id/etCode3"
                        android:layout_width="52dp" android:layout_height="60dp"
                        android:background="@drawable/input_light"
                        android:gravity="center" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1A1A2E" android:inputType="number"
                        android:maxLength="1" android:layout_marginHorizontal="5dp"/>
                    <EditText android:id="@+id/etCode4"
                        android:layout_width="52dp" android:layout_height="60dp"
                        android:background="@drawable/input_light"
                        android:gravity="center" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1A1A2E" android:inputType="number"
                        android:maxLength="1" android:layout_marginHorizontal="5dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60  Kodni qayta yuborish"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnVerifyCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Tasdiqlash"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_blue"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Step 3: Yangi parol -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="🔑"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_blue"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yangi parol"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yangi parolingizni kiriting"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Yangi parol"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:background="@drawable/input_light"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etConfirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Parolni tasdiqlang"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:background="@drawable/input_light"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Parolni o'zgartirish"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_blue"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Orqaga"
        android:textColor="#1B8EF8"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:layout_marginTop="16dp"
        android:stateListAnimator="@null"/>

</LinearLayout>