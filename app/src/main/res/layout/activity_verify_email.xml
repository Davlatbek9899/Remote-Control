<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F7FA"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="&#x2709;"
                android:textSize="32sp"
                android:gravity="center"
                android:background="@drawable/bg_circle_blue"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasdiqlash kodi"
                android:textColor="#1A1A2E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvVerifyEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kodni emailga yubordik"
                android:textColor="#888888"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <EditText android:id="@+id/etCode1"
                    android:layout_width="56dp" android:layout_height="64dp"
                    android:background="@drawable/input_light"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#1A1A2E" android:inputType="number"
                    android:maxLength="1" android:layout_marginHorizontal="6dp"/>

                <EditText android:id="@+id/etCode2"
                    android:layout_width="56dp" android:layout_height="64dp"
                    android:background="@drawable/input_light"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#1A1A2E" android:inputType="number"
                    android:maxLength="1" android:layout_marginHorizontal="6dp"/>

                <EditText android:id="@+id/etCode3"
                    android:layout_width="56dp" android:layout_height="64dp"
                    android:background="@drawable/input_light"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#1A1A2E" android:inputType="number"
                    android:maxLength="1" android:layout_marginHorizontal="6dp"/>

                <EditText android:id="@+id/etCode4"
                    android:layout_width="56dp" android:layout_height="64dp"
                    android:background="@drawable/input_light"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#1A1A2E" android:inputType="number"
                    android:maxLength="1" android:layout_marginHorizontal="6dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvResendCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kod kelmadimi? Qayta yuborish"
                android:textColor="#1B8EF8"
                android:textSize="13sp"
                android:layout_marginBottom="28dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#F0F0F0" android:layout_marginBottom="20dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnCancel"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:text="Bekor qilish"
                    android:textColor="#1A1A2E" android:textSize="15sp"
                    android:background="@drawable/card_white"
                    android:stateListAnimator="@null" android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnVerify"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:text="Tasdiqlash"
                    android:textColor="#FFFFFF" android:textSize="15sp"
                    android:background="@drawable/btn_blue"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>