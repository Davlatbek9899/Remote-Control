<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNavChild"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/nav_bar_bg"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout android:id="@+id/navHistoryTab"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📜" android:textSize="20sp" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tarix" android:textColor="#AAAAAA" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navCommandsTab"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📋" android:textSize="20sp" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Buyruqlar" android:textColor="#AAAAAA" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navHomeTab"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏠" android:textSize="20sp" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Asosiy" android:textColor="#AAAAAA" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navChildTab"
            android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/nav_item_selected">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👶" android:textSize="22sp" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Child" android:textColor="#1B8EF8" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfileTab"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👤" android:textSize="20sp" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Profil" android:textColor="#AAAAAA" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- No child screen -->
    <LinearLayout
        android:id="@+id/layoutNoChild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavChild"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Child Tracker" android:textSize="28sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Child tracker ning hali bola qo'shilmagan sahifasi."
            android:textSize="13sp" android:textColor="#AAAAAA"
            android:gravity="center" android:layout_marginBottom="48dp"/>

        <Button android:id="@+id/btnAddChild"
            android:layout_width="220dp" android:layout_height="52dp"
            android:text="Bola qo'shish  +"
            android:background="@drawable/btn_red" android:textColor="#FFFFFF"
            android:textSize="15sp" android:stateListAnimator="@null"
            android:layout_marginBottom="16dp"/>

        <Button android:id="@+id/btnBeWatcher"
            android:layout_width="220dp" android:layout_height="52dp"
            android:text="Kuzatulivchi bo'lish"
            android:background="@drawable/btn_red" android:textColor="#FFFFFF"
            android:textSize="15sp" android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Child tracking screen -->
    <LinearLayout
        android:id="@+id/layoutWithChild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavChild"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="#FFFFFF"
            android:paddingHorizontal="20dp" android:paddingTop="48dp"
            android:paddingBottom="14dp" android:gravity="center_vertical">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:layout_width="12dp" android:layout_height="12dp"
                    android:background="#2DC96B" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ismi" android:textColor="#1A1A2E"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" ▾" android:textColor="#1B8EF8" android:textSize="14sp"/>
            </LinearLayout>

            <Button android:id="@+id/btnAddChildHeader"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Bola qo'shish" android:background="@drawable/btn_blue"
                android:textColor="#FFFFFF" android:textSize="12sp"
                android:paddingHorizontal="12dp" android:stateListAnimator="@null"/>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Map card — kattaroq, sana/vaqt yo'q -->
                <FrameLayout android:layout_width="match_parent" android:layout_height="320dp"
                    android:background="#E8EEF4"
                    android:layout_marginBottom="10dp">

                    <android.webkit.WebView
                        android:id="@+id/mapWebView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <LinearLayout
                        android:id="@+id/mapFallback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📍" android:textSize="48sp"/>
                        <TextView android:id="@+id/tvMapAddress"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Joylashuv aniqlanmoqda..."
                            android:textColor="#1A1A2E" android:textSize="14sp"
                            android:textStyle="bold" android:gravity="center"
                            android:layout_marginTop="8dp"/>
                        <TextView android:id="@+id/tvMapCoords"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textColor="#888888" android:textSize="12sp"
                            android:gravity="center" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Soat tugmasi — tepa chap -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:elevation="6dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="4dp">
                        <ImageButton
                            android:id="@+id/btnTimeSelector"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_recent_history"
                            android:background="@android:color/transparent"
                            android:padding="8dp"
                            android:scaleType="fitCenter"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Share tugmasi — pastki chap -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="10dp"
                        android:elevation="6dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="4dp">
                        <ImageButton
                            android:id="@+id/btnShareLocation"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_share"
                            android:background="@android:color/transparent"
                            android:padding="9dp"
                            android:scaleType="fitCenter"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Sana va vaqt — pastki o'ng -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:orientation="horizontal"
                        android:background="#CC000000"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">
                        <TextView android:id="@+id/tvSelectedDate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Apr 4, 2026"
                            android:textColor="#FFFFFF" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvSelectedTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  9:41 AM"
                            android:textColor="#1B8EF8" android:textSize="11sp" android:textStyle="bold"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- App Usage card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#EBF3FF">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <!-- Chap: katta vaqt + bar chart -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="62" android:orientation="vertical">

                            <TextView android:id="@+id/tvTotalUsageTime"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0 soat"
                                android:textColor="#1A1A2E" android:textSize="26sp"
                                android:textStyle="bold" android:layout_marginBottom="2dp"/>

                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🔋" android:textSize="11sp" android:layout_marginEnd="4dp"/>
                                <TextView android:id="@+id/tvBatteryLevel"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="--" android:textColor="#888888" android:textSize="11sp"/>
                            </LinearLayout>

                            <!-- Bar chart -->
                            <com.example.remotecontrol.AppUsageBarView
                                android:id="@+id/appUsageBar"
                                android:layout_width="match_parent"
                                android:layout_height="140dp"/>
                        </LinearLayout>

                        <!-- O'ng: ilovalar ikonka + vaqt -->
                        <LinearLayout android:id="@+id/llAppLegend"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="38" android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:layout_marginStart="8dp"/>

                        <!-- Donut yashirin -->
                        <com.example.remotecontrol.AppUsageDonutView
                            android:id="@+id/appUsageDonut"
                            android:layout_width="1dp" android:layout_height="1dp"
                            android:visibility="invisible"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Quick actions row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">

                    <LinearLayout android:id="@+id/btnQuickCamera"
                        android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/card_white" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📸" android:textSize="26sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Suratga tushirish" android:textColor="#555555"
                            android:textSize="10sp" android:gravity="center" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnQuickAudio"
                        android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/card_white" android:layout_marginHorizontal="3dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🎙️" android:textSize="26sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ovozni eshitish" android:textColor="#555555"
                            android:textSize="10sp" android:gravity="center" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnQuickSms"
                        android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/card_white" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💬" android:textSize="26sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Oxirgi SMS lar" android:textColor="#555555"
                            android:textSize="10sp" android:gravity="center" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick actions row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">

                    <LinearLayout android:id="@+id/btnQuickCallLog"
                        android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/card_white" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📞" android:textSize="26sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Oxirgi qo'ng'iroqlar" android:textColor="#555555"
                            android:textSize="10sp" android:gravity="center" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnQuickScreenOff"
                        android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/card_white" android:layout_marginHorizontal="3dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔒" android:textSize="26sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ekranni o'chirish" android:textColor="#555555"
                            android:textSize="10sp" android:gravity="center" android:layout_marginTop="5dp"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnQuickAppExit"
                        android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/card_white" android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🚪" android:textSize="26sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ilovadan chiqib ketish" android:textColor="#555555"
                            android:textSize="10sp" android:gravity="center" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</RelativeLayout>
